# ── 依赖与构建产物（可再生产，别进仓库）─────────────────────────
node_modules/
dist/
dist-ssr/
target/
*.class

# ── 日志 ────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── 本地环境覆盖（可能含密钥，绝不提交）───────────────────────
*.local
.env.local
.env.*.local

# ── 编辑器 / 系统 ───────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── 本机临时 / 可再生的东西 ──────────────────────────────────
# node 的编译缓存
.node-compile-cache/

# 回退快照：它是"上 git 之前的手工版控制"，git 本身就是干这个的
_rollback/

# 验收截图（约 2.8M）：探针跑一遍就能重新生成
_probe/shots/*.png

# 预跑缓存（约 300K）：里面是真实上游返回，跑一次 prerun.mjs 就有了
# 探针实例用的是副本（`-probe`），同样不进仓库 —— 它只是为了避免两个进程抢同一个文件
_probe/flyai-cache.json
_probe/flyai-cache-probe.json

# 部署配置：它描述的是"我这台后端机"的事实（内网地址、服务名、证书路径），
# 不是这个项目的事实 —— 而且里面迟早会落进真实环境变量。留在本机，不进仓库。
deploy/
